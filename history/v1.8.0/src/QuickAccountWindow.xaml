<Window x:Class="Gameorder.QuickAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gameorder"
        Title="Gameorder" Width="660" Height="410" MinWidth="360" MinHeight="270"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" Foreground="#25354D"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <local:AvatarImageConverter x:Key="AvatarImage"/>
        <Style TargetType="TextBlock" x:Key="Glyph"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Button" x:Key="QuickButton">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#7085A4"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="28"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#EAF1FE"/><Setter Property="Foreground" Value="#326BDE"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#326BDE"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource QuickButton}"/>
        <Style TargetType="Button" x:Key="QuickIconButton" BasedOn="{StaticResource QuickButton}"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/></Style>
        <Style TargetType="Button" x:Key="QuickFolderChip" BasedOn="{StaticResource QuickButton}">
            <Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="31"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#EAF1FE"/><Setter Property="Foreground" Value="#2F65CA"/><Setter Property="BorderBrush" Value="#D5E2FA"/></DataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="Ellipse" x:Key="QuickPresenceDot">
            <Setter Property="Fill" Value="#AEBACB"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="#38A77B"/></DataTrigger><DataTrigger Binding="{Binding IsOffline}" Value="True"><Setter Property="Fill" Value="#D1A04F"/></DataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="Thumb" x:Key="QuickScrollThumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#CDD7E5" CornerRadius="4" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#96AAC5"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#7491B9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb x:Name="Grip" Style="{StaticResource QuickScrollThumb}" MinHeight="24"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Grip" Property="MinHeight" Value="0"/><Setter TargetName="Grip" Property="MinWidth" Value="24"/><Setter TargetName="Decrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="Increase" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Margin="10" Background="White" BorderBrush="#DAE3EF" BorderThickness="1" CornerRadius="22" Padding="18,16">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.16" Color="#385174"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="assets/Gameorder.png" Width="28" Height="28" Margin="0,0,10,0"/><TextBlock Text="Gameorder" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#FFF5E4" CornerRadius="7" Padding="6,3" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}"><TextBlock Text="演示" FontSize="9" Foreground="#B39059"/></Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Click="OpenFullWindowClick" Style="{StaticResource QuickIconButton}" ToolTip="打开完整账号管理窗口" AutomationProperties.Name="打开完整账号管理窗口" Margin="0,0,4,0"><TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}"/></Button><Button Click="ClosePopupClick" Style="{StaticResource QuickIconButton}" ToolTip="收起快捷栏" AutomationProperties.Name="收起快捷栏"><TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12"/></Button></StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10" AutomationProperties.Name="快捷栏账号文件夹">
                <ItemsControl ItemsSource="{Binding Folders}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Style="{StaticResource QuickFolderChip}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"><StackPanel Orientation="Horizontal"><TextBlock FontSize="12" Margin="0,0,6,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}"><Setter Property="FontSize" Value="12"/><Setter Property="Text" Value="&#xE8B7;"/><Style.Triggers><DataTrigger Binding="{Binding Id}" Value="*"><Setter Property="Text" Value="&#xE80A;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Name}" MaxWidth="95" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding AccountCount}" FontSize="10" Margin="6,0,0,0" Opacity="0.55" VerticalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#F5F7FB" CornerRadius="10" Margin="0,0,0,11" Padding="11,0" BorderBrush="#E9EDF4" BorderThickness="1">
                <Grid Height="32"><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Foreground="#8C9DB5"/>
                    <TextBox x:Name="QuickSearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0,7" FontSize="11" Foreground="#354B69" VerticalContentAlignment="Center" AutomationProperties.Name="搜索快捷账号" ToolTip="搜索账号名称或备注"/>
                    <TextBlock Grid.Column="1" Text="搜索账号 / 备注" FontSize="11" Foreground="#96A5B9" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Style="{StaticResource QuickIconButton}" Width="25" Height="25" MinHeight="25" ToolTip="清空搜索" AutomationProperties.Name="清空搜索"><TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="9"/></Button>
                </Grid>
            </Border>
            <Grid Grid.Row="3">
                <ScrollViewer x:Name="AccountScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,0,1,0" AutomationProperties.Name="可滚动快捷账号头像栏">
                    <ItemsControl x:Name="QuickAccountsControl" ItemsSource="{Binding Accounts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Width="106" Height="162" Margin="0,0,8,8" Padding="8" BorderThickness="1" CornerRadius="14" ToolTip="{Binding AccountName}">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FBFCFE"/><Setter Property="BorderBrush" Value="#E7EDF6"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#F2FAF6"/><Setter Property="BorderBrush" Value="#CBE5D9"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F6FE"/><Setter Property="BorderBrush" Value="#C9DAF4"/></Trigger></Style.Triggers></Style></Border.Style>
                            <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button Click="OnlineAccountClick" Padding="0" MinHeight="0" Height="48" Width="48" HorizontalAlignment="Center" ToolTip="{Binding AvatarHint}" AutomationProperties.Name="{Binding DisplayName}" IsEnabled="{Binding DataContext.CanSwitch, RelativeSource={RelativeSource AncestorType=Window}}"><Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                    <Grid Width="48" Height="48"><Border Background="{Binding Accent}" CornerRadius="24"><TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}" FontSize="20" Foreground="#7187A5" HorizontalAlignment="Center"/></Border><Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolVisibility}}"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarImage}}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><Ellipse Width="11" Height="11" Style="{StaticResource QuickPresenceDot}" Stroke="White" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="{Binding PresenceHint}"/></Grid>
                                </Button>
                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding DisplayName}"/>
                                <TextBlock Grid.Row="2" Text="{Binding PresenceLabel}" FontSize="10" TextAlignment="Center" Margin="0,3,0,0" ToolTip="{Binding PresenceHint}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#8A9BB1"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Foreground" Value="#2E9270"/></DataTrigger><DataTrigger Binding="{Binding IsOffline}" Value="True"><Setter Property="Foreground" Value="#AC8746"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <TextBlock Grid.Row="3" Text="{Binding NotePreview}" Foreground="#778AA5" FontSize="10" LineHeight="12" MaxHeight="24" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" ToolTip="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="快捷账号备注"/>
                                <Grid Grid.Row="4" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Click="OnlineAccountClick" Padding="0" Height="25" MinHeight="25" Background="#EAF1FE" Foreground="#3C71C8" ToolTip="在线切换" AutomationProperties.Name="在线切换" IsEnabled="{Binding DataContext.CanSwitch, RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="13"/></Button><Button Grid.Column="2" Click="OfflineAccountClick" Padding="0" Height="25" MinHeight="25" ToolTip="离线切换，需要已保存的登录" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="离线切换"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuickButton}"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasCachedLogin}" Value="True"/><Condition Binding="{Binding DataContext.CanSwitch, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="&#xEB5E;" Style="{StaticResource Glyph}" FontSize="13"/></Button></Grid>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
                <Border Background="#FAFBFE" CornerRadius="12" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"><TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="24" Foreground="#A3B4CF" HorizontalAlignment="Center" Margin="0,0,0,12"/><TextBlock Text="没有匹配账号" FontSize="13" Foreground="#7187A5" HorizontalAlignment="Center"/><Button Content="打开账号管理" Click="OpenFullWindowClick" Margin="0,10,0,0" FontSize="11"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="4" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding AccountsSummary}" FontSize="10" Foreground="#97A7BD" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" Margin="12,0,0,0" ToolTip="{Binding SessionHint}"><Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,5,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#AEBACB"/><Style.Triggers><DataTrigger Binding="{Binding IsSessionOnline}" Value="True"><Setter Property="Fill" Value="#38A77B"/></DataTrigger><DataTrigger Binding="{Binding IsSessionOffline}" Value="True"><Setter Property="Fill" Value="#D1A04F"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding SessionSummary}" FontSize="10" Foreground="#879AB4"/></StackPanel></StackPanel><Button Grid.Column="1" Click="OpenFullWindowClick" Padding="7,3" MinHeight="24" FontSize="10" ToolTip="完整账号管理"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,5,0"/><TextBlock Text="管理" VerticalAlignment="Center"/></StackPanel></Button></Grid>
            <Border Grid.Row="5" Margin="0,7,0,0" Background="#EFF4FD" BorderBrush="#DFE8F8" BorderThickness="1" CornerRadius="10" Padding="10,8" Visibility="{Binding MainModel.OperationVisible, Converter={StaticResource BoolVisibility}}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding MainModel.StatusTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#516F9D"/><TextBlock Text="{Binding MainModel.StatusMessage}" FontSize="10" Foreground="#7E92AE" TextTrimming="CharacterEllipsis" Margin="0,3,12,0" ToolTip="{Binding MainModel.StatusMessage}"/><ProgressBar Height="3" IsIndeterminate="True" Margin="0,6,10,0" Foreground="#4D7DD0" Background="#DCE7F8" Visibility="{Binding MainModel.IsBusy, Converter={StaticResource BoolVisibility}}"/></StackPanel><Button Grid.Column="1" Command="{Binding MainModel.DismissStatusCommand}" Style="{StaticResource QuickIconButton}" Width="22" Height="22" MinHeight="22" ToolTip="关闭状态提示"><TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="9"/></Button></Grid>
            </Border>
            <Border Grid.RowSpan="6" Background="#F8FAFE" CornerRadius="14" Visibility="{Binding MainModel.PendingConfirmation, Converter={StaticResource BoolVisibility}}" Padding="24,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center" Margin="0,3">
                    <Grid Width="50" Height="50" HorizontalAlignment="Center" Margin="0,0,0,14"><Border Background="{Binding MainModel.SelectedAccount.Accent}" CornerRadius="25"><TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}" FontSize="23" Foreground="#7187A5" HorizontalAlignment="Center"/></Border><Ellipse Visibility="{Binding MainModel.SelectedAccount.HasAvatar, Converter={StaticResource BoolVisibility}}"><Ellipse.Fill><ImageBrush ImageSource="{Binding MainModel.SelectedAccount.AvatarPath, Converter={StaticResource AvatarImage}}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid>
                    <TextBlock Text="{Binding MainModel.ConfirmationTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding MainModel.ConfirmationMessage}" FontSize="11" LineHeight="19" Foreground="#71849F" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0"><Button Content="取消" Command="{Binding MainModel.CancelConfirmCommand}" Padding="18,9" Margin="0,0,10,0"/><Button Content="确认切换" Command="{Binding MainModel.ConfirmCommand}" Background="#326BDE" Foreground="White" Padding="18,9"/></StackPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
