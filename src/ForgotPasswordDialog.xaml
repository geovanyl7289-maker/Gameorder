<Window x:Class="Gameorder.ForgotPasswordDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Gameorder · 永久清空" Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FFF9F8" Foreground="#24334A"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0" CornerRadius="18" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#536986"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="14,12"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E6D8D5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    </Window.Resources>
    <Border BorderBrush="#EAD9D4" BorderThickness="1" CornerRadius="18" Padding="30">
        <StackPanel>
            <Border Width="54" Height="54" CornerRadius="17" Background="#FBE5E0" HorizontalAlignment="Left"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="#C84A37" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="永久清空本机 Steam 账号资料" FontSize="28" FontWeight="Bold" Foreground="#B83C2B" TextWrapping="Wrap" Margin="0,18,0,0"/>
            <TextBlock Text="不可恢复" FontSize="19" FontWeight="SemiBold" Foreground="#C94D3B" Margin="0,7,0,18"/>
            <TextBlock Text="账号 · 备注 · 分组 · 操作记录&#x0a;头像缓存 · Gameorder 生成的备份" Foreground="#765A57" FontSize="14" LineHeight="24" TextWrapping="Wrap"/>
            <TextBlock Text="清空后禁用应用锁，不会自动重新导入。" Foreground="#927772" FontSize="12" Margin="0,9,0,0"/>
            <TextBlock Text="Steam 客户端、游戏和 Steam 保存的登录保持不变。" Foreground="#927772" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,18"/>
            <Border Background="#FFF0CE" CornerRadius="10" Padding="12,9" Margin="0,0,0,15" Visibility="{Binding ViewModel.IsResetTest,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource BoolVisibility}}"><TextBlock Text="重置测试 · 仅清空隔离的虚拟资料" Foreground="#8B5D15" FontWeight="SemiBold" FontSize="12"/></Border>
            <TextBox x:Name="ConfirmationBox" Text="{Binding ConfirmationText,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" IsEnabled="{Binding IsConfirmation}" AutomationProperties.Name="输入我已经确认"/>
            <TextBlock Text="{Binding StatusText}" Foreground="#9F665B" FontSize="13" Margin="1,12,0,16"/>
            <Button x:Name="ContinueButton" Content="开始 15 秒冷静确认" Click="ContinueClick" IsEnabled="{Binding CanStartCooling}" Visibility="{Binding IsConfirmation,Converter={StaticResource BoolVisibility}}" Background="#F4E9E5" Foreground="#865B51"/>
            <Grid Margin="0,10,0,0">
                <Button x:Name="HoldButton" Content="永久清空并重置" IsEnabled="{Binding CanHold}" Background="#C94E3C" Foreground="White" FontSize="16" FontWeight="SemiBold" MinHeight="52"
                        PreviewMouseLeftButtonDown="HoldMouseDown" PreviewMouseLeftButtonUp="HoldMouseUp" PreviewMouseMove="HoldMouseMove" PreviewKeyDown="HoldKeyDown" PreviewKeyUp="HoldKeyUp" LostMouseCapture="HoldLostCapture" LostKeyboardFocus="HoldLostFocus"/>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding HoldProgress,Mode=OneWay}" Height="4" VerticalAlignment="Bottom" Margin="12,0,12,5" IsHitTestVisible="False" Background="Transparent" Foreground="#FFE3A4"/>
            </Grid>
            <TextBlock x:Name="ResetError" Foreground="#B64233" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Button x:Name="CancelButton" Content="取消，保留资料" Click="CancelClick" Margin="0,13,0,0" IsCancel="True"/>
        </StackPanel>
    </Border>
</Window>
