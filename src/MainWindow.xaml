            <Border Grid.Row="3" BorderThickness="1" CornerRadius="12" Padding="16,13" Margin="0,18,0,0" Visibility="{Binding OperationVisible, Converter={StaticResource BoolVisibility}}">
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EDF3FE"/><Setter Property="BorderBrush" Value="#D2E0F9"/><Style.Triggers><DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="Background" Value="#FFF1EF"/><Setter Property="BorderBrush" Value="#F0D5D0"/></DataTrigger><DataTrigger Binding="{Binding StatusKind}" Value="success"><Setter Property="Background" Value="#EDF7F1"/><Setter Property="BorderBrush" Value="#D4E8DB"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding StatusMessage}" Foreground="#5E7089" FontSize="12" TextWrapping="Wrap" Margin="0,5,14,0"/><ProgressBar Height="3" IsIndeterminate="True" Margin="0,11,16,0" Foreground="#326BDE" Background="#D9E5F8" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/></StackPanel><Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Style="{StaticResource QuietButton}" Command="{Binding DismissStatusCommand}" Padding="7" MinHeight="30" Width="30" VerticalAlignment="Top" AutomationProperties.Name="关闭状态提示" ToolTip="关闭提示"/></Grid>
            </Border>
        </Grid>
        <Grid x:Name="FolderDialog" Grid.Row="1" Grid.ColumnSpan="2" Background="#70232E42" Visibility="{Binding IsFolderDialogOpen, Converter={StaticResource BoolVisibility}}">
            <Border Width="430" MaxHeight="590" Margin="20" Background="White" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="20" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="#EDF3FE" CornerRadius="12"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="18" Foreground="#4776C5" HorizontalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{Binding FolderDialogTitle}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/></Grid>
                    <TextBlock Text="文件夹名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FolderDraftName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="文件夹名称" MaxLength="64"/>
                    <TextBlock Text="{Binding FolderFormError}" Foreground="#AA4E52" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="取消" Command="{Binding CloseFolderCommand}" Margin="0,0,10,0"/><Button Content="保存" Command="{Binding SaveFolderCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <Grid x:Name="AccountEditDialog" Grid.Row="1" Grid.ColumnSpan="2" Background="#70232E42" Visibility="{Binding IsEditAccountOpen, Converter={StaticResource BoolVisibility}}">
            <Border Width="470" MaxHeight="590" Margin="20" Background="White" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="20" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="#EDF3FE" CornerRadius="12"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="18" Foreground="#4776C5" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="管理账号" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedAccount.AccountName}" FontSize="11" Foreground="#8492A7" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
                        <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" Height="44" MaxLength="80" AutomationProperties.Name="编辑显示名称" Margin="0,0,0,20"/>
                        <TextBlock Text="文件夹" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding EditFolderChoice, Mode=TwoWay}" AutomationProperties.Name="账号文件夹" Margin="0,0,0,20"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="编辑账号备注"/>
                        <TextBlock Text="{Binding EditFormError}" Foreground="#AA4E52" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel></ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="取消" Command="{Binding CloseEditAccountCommand}" Margin="0,0,10,0"/><Button Content="保存" Command="{Binding SaveEditAccountCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Background="#70232E42" Visibility="{Binding IsAddAccountOpen, Converter={StaticResource BoolVisibility}}">
            <Border Width="470" Background="White" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="20" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel><TextBlock Text="添加账号" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="添加登录名称，在 Steam 完成验证。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,9,0,25"/>
                    <TextBlock Text="Steam 登录名称" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新账号登录名称" Margin="0,0,0,18"/>
                    <TextBlock Text="显示名称 · 可选" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="新账号显示名称"/>
                    <TextBlock Text="{Binding AddFormError}" Foreground="#AA4E52" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Border Background="#F5F8FC" CornerRadius="10" Padding="13" Margin="0,8,0,24"><TextBlock Text="首次使用请在线登录，以保存离线授权。" TextWrapping="Wrap" FontSize="12" Foreground="#61718A" LineHeight="21"/></Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Command="{Binding CloseAddAccountCommand}" Margin="0,0,10,0"/><Button Content="添加账号" Command="{Binding SaveNewAccountCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Background="#70232E42" Visibility="{Binding PendingConfirmation, Converter={StaticResource BoolVisibility}}">
            <Border Width="470" Background="White" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="20" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="{Binding ConfirmationTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ConfirmationMessage}" Foreground="#62718A" TextWrapping="Wrap" LineHeight="24" Margin="0,14,0,28"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Command="{Binding CancelConfirmCommand}" Margin="0,0,10,0"/><Button Content="确认" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel></Border>
        </Grid>
        <Grid x:Name="LockOverlay" Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="100" Background="#F5F7FB" Visibility="{Binding IsLocked,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="应用锁定界面">
            <Ellipse Width="420" Height="420" Fill="#EAF0FB" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-120,-70,0,0"/>
            <Border Width="390" Background="White" BorderBrush="#DEE8F6" BorderThickness="1" CornerRadius="26" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="60" Height="60" Background="#EAF1FE" CornerRadius="19" HorizontalAlignment="Center"><TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="#5780C5" FontSize="28" HorizontalAlignment="Center"/></Border>
                    <TextBlock Text="Gameorder 已锁定" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,21,0,0"/>
                    <TextBlock Text="输入应用密码" FontSize="12" Foreground="#91A1B9" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                    <Grid x:Name="UnlockInputGroup" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding AppLockChecking}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding AppLockConfigurationError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="UnlockPassword" KeyDown="UnlockPasswordKeyDown" Style="{StaticResource LockPasswordStyle}" AutomationProperties.Name="应用解锁密码"/>
                        <TextBox x:Name="UnlockPasswordPlain" Visibility="Collapsed" KeyDown="UnlockPasswordKeyDown" MinHeight="48" Padding="14,12" MaxLength="4096" SpellCheck.IsEnabled="False" AutomationProperties.Name="应用解锁密码，可见"/>
                        <ToggleButton x:Name="UnlockPasswordReveal" Grid.Column="1" Style="{StaticResource PasswordEye}"/>
                    </Grid>
                    <Border x:Name="UnlockErrorBanner" Background="#FFF0F2" BorderBrush="#F2D2D8" BorderThickness="1" CornerRadius="12" Padding="12,11" Margin="0,12,0,0" Visibility="{Binding HasAppLockMessage,Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Assertive">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" Foreground="#BC485A" FontSize="16" VerticalAlignment="Center"/><TextBlock x:Name="UnlockErrorText" Grid.Column="1" Text="{Binding AppLockMessage}" Foreground="#B34454" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
                    </Border>
                    <Border x:Name="PasswordHintBanner" Background="#F3F6FC" CornerRadius="12" Padding="13,11" Margin="0,9,0,0" Visibility="{Binding ShowPasswordHint,Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite">
                        <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Foreground="#7891B3" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="密码提示" Foreground="#7891B3" FontSize="11"/></StackPanel><TextBlock x:Name="PasswordHintText" Text="{Binding CurrentPasswordHint}" TextWrapping="Wrap" Foreground="#526A8C" FontSize="14" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Button Click="UnlockClick" Margin="0,14,0,0" AutomationProperties.Name="解锁 Gameorder"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding AppLockChecking}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding AppLockConfigurationError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE785;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="解锁"/></StackPanel></Button>
                    <Button Command="{Binding ForgotPasswordCommand}" Content="忘记密码" Style="{StaticResource QuietButton}" Margin="0,12,0,0" ToolTip="清空本机账号资料后重置，无法恢复" AutomationProperties.Name="忘记密码并清空资料"/>
                    <TextBlock Text="测试密码：12345678" FontSize="12" Foreground="#A5762B" TextAlignment="Center" Margin="0,12,0,0" Visibility="{Binding IsResetTest,Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
