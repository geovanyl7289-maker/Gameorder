<Window x:Class="Gameorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gameorder"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Gameorder" Icon="assets/Gameorder.ico" Width="1280" Height="820" MinWidth="1000" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14" Foreground="#24334A" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7" GlassFrameThickness="1" CornerRadius="12" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BitmapImage x:Key="CreatorAvatarPreview" UriSource="assets/CreatorAvatar.png" DecodePixelWidth="208" CacheOption="OnLoad"/>
        <Style TargetType="Thumb" x:Key="SlimScrollThumb">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#C8D2DF" CornerRadius="5" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#9DACBF"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#7E94B2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                    <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb x:Name="GripThumb" MinHeight="24" Style="{StaticResource SlimScrollThumb}"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                </Track>
                <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="GripThumb" Property="MinHeight" Value="0"/><Setter TargetName="GripThumb" Property="MinWidth" Value="24"/><Setter TargetName="Decrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="Increase" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <local:AvatarImageConverter x:Key="AvatarImage"/>
        <SolidColorBrush x:Key="Muted" Color="#738197"/>
        <SolidColorBrush x:Key="Line" Color="#E6EAF0"/>
        <SolidColorBrush x:Key="Blue" Color="#326BDE"/>
        <Style TargetType="Button" x:Key="ButtonBase">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#344359"/>
            <Setter Property="BorderBrush" Value="#DDE3EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#326BDE"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#326BDE"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#326BDE"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button" x:Key="QuietButton" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="Button" x:Key="TitleBarButton" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7B8DA6"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CaptionButtonFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionButtonFrame" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CaptionButtonFrame" Property="BorderBrush" Value="#AEBFDC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EDF2F9"/><Setter Property="Foreground" Value="#3D5D87"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ToggleButton" x:Key="TaskbarWidgetSwitch">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="SwitchTrack" Background="#DDE5F0" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14"><Grid Margin="3"><Border x:Name="SwitchKnob" Background="White" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Left"><TextBlock x:Name="SwitchCheck" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#326BDE" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#326BDE"/><Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="SwitchCheck" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#8CACDC"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" x:Key="TaskbarDockChoice" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#F5F7FC"/><Setter Property="BorderBrush" Value="#E7EDF5"/><Setter Property="Foreground" Value="#7288A6"/>
            <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="13,8"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button" x:Key="NavButton" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF2F6"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="FilterButton" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Width" Value="42"/><Setter Property="MinHeight" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="PasswordBox" x:Key="LockPasswordStyle">
            <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="14,12"/><Setter Property="MaxLength" Value="4096"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E3F4"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="LockPasswordFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="13"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="LockPasswordFrame" Property="BorderBrush" Value="#326BDE"/></Trigger><DataTrigger Binding="{Binding HasAppLockMessage}" Value="True"><Setter TargetName="LockPasswordFrame" Property="BorderBrush" Value="#D76D7B"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ToggleButton" x:Key="PasswordEye">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#8294AE"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTip" Value="显示密码"/><Setter Property="AutomationProperties.Name" Value="显示密码"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="EyeFrame" Background="{TemplateBinding Background}" CornerRadius="11"><TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EyeFrame" Property="Background" Value="#E8F0FE"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="EyeFrame" Property="Background" Value="#E8F0FE"/><Setter Property="Foreground" Value="#326BDE"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EyeFrame" Property="Background" Value="#E8F0FE"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24334A"/>
            <Setter Property="BorderBrush" Value="#DDE3EB"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputFrame" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="#326BDE"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputFrame" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="SmallLabel"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel" BasedOn="{StaticResource SmallLabel}"><Setter Property="Margin" Value="0,0,0,7"/></Style>
        <Style TargetType="TextBlock" x:Key="Icon"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Button" x:Key="FolderChip" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="MinHeight" Value="35"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Foreground" Value="#7788A1"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#EAF1FE"/><Setter Property="Foreground" Value="#2F65CA"/><Setter Property="BorderBrush" Value="#D3E1FA"/></DataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Choice" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="3,2"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="#EDF3FE"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="#EAF1FE"/><Setter Property="Foreground" Value="#2F65CA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24334A"/><Setter Property="BorderBrush" Value="#DDE3EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ChoiceFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#7788A1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#AEBFD7"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="#326BDE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="13,10,35,10" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                        <Border Background="White" BorderBrush="#DDE5F0" BorderThickness="1" CornerRadius="12" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0"><ScrollViewer MaxHeight="230" CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem" x:Key="AccountTile">
            <Setter Property="Width" Value="160"/><Setter Property="Height" Value="220"/>
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E6EAF0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding GamePresenceHint}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TileFrame" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="TileFrame" Property="Background" Value="#F6FBF9"/><Setter TargetName="TileFrame" Property="BorderBrush" Value="#C6E2D6"/></DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileFrame" Property="Background" Value="#F5F8FD"/><Setter TargetName="TileFrame" Property="BorderBrush" Value="#CBD9ED"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TileFrame" Property="Background" Value="#EDF3FF"/><Setter TargetName="TileFrame" Property="BorderBrush" Value="#326BDE"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TileFrame" Property="BorderBrush" Value="#326BDE"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="Button" x:Key="FolderActionButton" BasedOn="{StaticResource IconButton}">
            <Setter Property="MinHeight" Value="35"/><Setter Property="Width" Value="30"/><Setter Property="Height" Value="35"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers><DataTrigger Binding="{Binding ActiveFolderId}" Value="*"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ActiveFolderId}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="RailButton" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Width" Value="54"/><Setter Property="Height" Value="54"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#74859D"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EDF2F9"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="Ellipse" x:Key="PresenceDot">
            <Setter Property="Fill" Value="#ADB8C7"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="#37A77B"/></DataTrigger><DataTrigger Binding="{Binding IsOffline}" Value="True"><Setter Property="Fill" Value="#D6A251"/></DataTrigger><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Fill" Value="#9266D2"/></DataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="Ellipse" x:Key="SessionDot">
            <Setter Property="Fill" Value="#A7B3C4"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSessionOnline}" Value="True"><Setter Property="Fill" Value="#37A77B"/></DataTrigger><DataTrigger Binding="{Binding IsSessionOffline}" Value="True"><Setter Property="Fill" Value="#D6A251"/></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="#FCFDFE" BorderBrush="#E7EDF5" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
            <Grid Margin="17,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="assets/Gameorder.png" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock Text="Gameorder" FontSize="12.5" FontWeight="SemiBold" Foreground="#536B8D" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsResetTest,Converter={StaticResource BoolVisibility}}">
                    <Border Background="#FFF1DA" CornerRadius="7" Padding="10,4"><TextBlock Text="重置测试 · 虚拟数据" FontSize="12" FontWeight="SemiBold" Foreground="#996522"/></Border>
                    <Button Command="{Binding RestoreResetTestDataCommand}" Content="重建测试数据" Margin="10,0,0,0" MinHeight="26" Padding="9,4" FontSize="11" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="恢复虚拟账号与测试密码，不操作正式资料"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TitleMinimizeButton" Click="TitleMinimizeClick" Style="{StaticResource TitleBarButton}" ToolTip="最小化到后台" AutomationProperties.Name="最小化" Margin="0,0,4,0"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
                    <Button x:Name="TitleCloseButton" Click="TitleCloseClick" ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#B8636F"/><Setter Property="Background" Value="#FCEFF0"/></Trigger></Style.Triggers></Style></Button.Style><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Background="#FCFDFE" BorderBrush="#E5EAF2" BorderThickness="0,0,1,0">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Visibility" Value="Hidden"/></DataTrigger><DataTrigger Binding="{Binding IsAddAccountOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding HasManagementDialog}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding PendingConfirmation}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid Margin="18,26,18,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Image Source="assets/Gameorder.png" Width="48" Height="48" Margin="0,0,0,44" ToolTip="Gameorder" AutomationProperties.Name="Gameorder"/>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <Button Command="{Binding ShowAccountsCommand}" ToolTip="账号" AutomationProperties.Name="账号库">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAccountsView}" Value="True"><Setter Property="Background" Value="#EAF1FE"/><Setter Property="Foreground" Value="#326BDE"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="21"/>
                    </Button>
                    <Button Command="{Binding ShowHistoryCommand}" ToolTip="操作记录" AutomationProperties.Name="操作记录">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding IsHistoryView}" Value="True"><Setter Property="Background" Value="#EAF1FE"/><Setter Property="Foreground" Value="#326BDE"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="21"/>
                    </Button>
                    <Button Command="{Binding ShowSettingsCommand}" ToolTip="设置" AutomationProperties.Name="设置">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsView}" Value="True"><Setter Property="Background" Value="#EAF1FE"/><Setter Property="Foreground" Value="#326BDE"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="21"/>
                    </Button>
                    <Button x:Name="AboutNavigationButton" Command="{Binding ShowAboutCommand}" ToolTip="关于 Gameorder" AutomationProperties.Name="关于 Gameorder">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAboutView}" Value="True"><Setter Property="Background" Value="#EAF1FE"/><Setter Property="Foreground" Value="#326BDE"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="21"/>
                    </Button>
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="#E7ECF3" BorderThickness="0,1,0,0" Padding="0,22,0,0" ToolTip="{Binding ClientStatus}">
